const std = @import("std");

const constants = @import("science/constants.zig");
const units = @import("science/units.zig");
const particles = @import("science/particles.zig");
const observations = @import("science/observations.zig");

fn printHeader() void {
    std.debug.print(
        \\
        \\========================================
        \\                 ORIGIN
        \\       PARTICLE OBSERVATION ENGINE
        \\========================================
        \\
    , .{});
}

fn printHelp() void {
    std.debug.print(
        \\
        \\USAGE:
        \\  origin info
        \\  origin science
        \\  origin help
        \\
    , .{});
}

fn printInfo() void {
    std.debug.print(
        \\
        \\ORIGIN SYSTEM INFORMATION
        \\
        \\Version:       0.1.0
        \\Language:      Zig
        \\Platform:      macOS
        \\Storage:       Local
        \\Interface:     Terminal
        \\
        \\Scientific modules: Available
        \\Dataset engine:     Pending
        \\Analysis engine:    Pending
        \\
    , .{});
}

fn printScience() void {
    const vector = observations.Vector3{
        .x = 3.0,
        .y = 4.0,
        .z = 0.0,
    };

    std.debug.print(
        \\
        \\========================================
        \\          ORIGIN SCIENCE ENGINE
        \\========================================
        \\
        \\PHYSICAL CONSTANTS
        \\
        \\Speed of light: {} m/s
        \\Planck constant: {} J*s
        \\Elementary charge: {} C
        \\Electron mass: {} kg
        \\Proton mass: {} kg
        \\
        \\MEASUREMENT SYSTEM
        \\
        \\Length: meters
        \\Mass: kilograms
        \\Time: seconds
        \\Momentum: kg*m/s
        \\Energy: joules
        \\
        \\1000 meters = {} kilometers
        \\
        \\PARTICLE CATALOGUE
        \\
        \\Electron: {s}
        \\Muon: {s}
        \\Tau: {s}
        \\Proton: {s}
        \\Neutron: {s}
        \\Photon: {s}
        \\
        \\OBSERVATION FRAMEWORK
        \\
        \\Test vector magnitude: {}
        \\
        \\Scientific modules: ONLINE
        \\Particle entries: 6
        \\
    , .{
        constants.speed_of_light,
        constants.planck_constant,
        constants.elementary_charge,
        constants.electron_mass,
        constants.proton_mass,
        units.metersToKilometers(1000.0),
        particles.electron.name,
        particles.muon.name,
        particles.tau.name,
        particles.proton.name,
        particles.neutron.name,
        particles.photon.name,
        observations.momentumMagnitude(vector),
    });
}

pub fn main(init: std.process.Init) void {
    var args = init.minimal.args.iterate();
    _ = args.skip();

    printHeader();

    const command = args.next() orelse {
        printHelp();
        return;
    };

    if (std.mem.eql(u8, command, "info")) {
        printInfo();
    } else if (std.mem.eql(u8, command, "science")) {
        printScience();
    } else if (std.mem.eql(u8, command, "help")) {
        printHelp();
    } else {
        std.debug.print(
            \\
            \\Unknown command: {s}
            \\
        , .{command});
    }
}
