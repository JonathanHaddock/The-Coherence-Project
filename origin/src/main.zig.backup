
const std = @import("std");

fn printHeader() void {
    std.debug.print(
        \\
        \\========================================
        \\                 ORIGIN
        \\       PARTICLE OBSERVATION ENGINE
        \\========================================
        \\
    , .{});
}

fn printHelp() void {
    std.debug.print(
        \\
        \\USAGE:
        \\  origin info
        \\  origin help
        \\
        \\MODULES:
        \\  Dataset acquisition
        \\  Integrity verification
        \\  Particle data import
        \\  Momentum reconstruction
        \\  Invariant mass analysis
        \\  Koide analysis
        \\
    , .{});
}

fn printInfo() void {
    std.debug.print(
        \\
        \\ORIGIN SYSTEM INFORMATION
        \\
        \\Version:       0.1.0
        \\Language:      Zig
        \\Platform:      macOS
        \\Storage:       Local
        \\Interface:     Terminal
        \\
        \\Scientific modules: Initializing
        \\Dataset engine:     Pending
        \\Analysis engine:    Pending
        \\
    , .{});
}

pub fn main(init: std.process.Init) void {
    var args = init.minimal.args.iterate();

    // Skip executable name.
    _ = args.skip();

    printHeader();

    const command = args.next() orelse {
        printHelp();
        return;
    };

    if (std.mem.eql(u8, command, "info")) {
        printInfo();
    } else if (std.mem.eql(u8, command, "help")) {
        printHelp();
    } else {
        std.debug.print(
            \\
            \\Unknown command: {s}
            \\Use 'origin help' for assistance.
            \\
        , .{command});
    }
}
